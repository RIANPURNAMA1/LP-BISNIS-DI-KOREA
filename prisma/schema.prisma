generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Pendaftaran {
  id         Int      @id @default(autoincrement())
  nama       String   @db.VarChar(255)
  whatsapp   String   @db.VarChar(30)
  email      String   @db.VarChar(255)
  provinsi   String   @db.VarChar(100)
  kabupaten  String   @db.VarChar(100)
  kecamatan  String   @db.VarChar(100)
  desa       String   @db.VarChar(100)
  alamat     String?  @db.Text
  status     String   @db.VarChar(100)
  ide        String   @db.VarChar(100)
  cerita     String?  @db.Text
  pendapatan String?  @db.VarChar(50)
  tujuan     String   @db.LongText
  sumber     String?  @db.VarChar(100)
  // jabodetabek | luar_jabodetabek | luar_negeri (kosong untuk data lama)
  wilayah    String   @default("") @db.VarChar(30)
  // "" (belum ikut) | webinar | seminar | keduanya — diatur admin
  eventStatus String  @default("") @map("event_status") @db.VarChar(30)
  // Hash bcrypt untuk login peserta; null = belum punya akses (data lama).
  password    String? @db.VarChar(255)
  lastLoginAt DateTime? @map("last_login_at")
  // Gerbang akses member: HANYA diisi admin saat pembayaran terverifikasi.
  // null = peserta belum boleh masuk area /peserta.
  aksesAktifAt DateTime? @map("akses_aktif_at")
  // Progres alur peserta: selesai menonton video, lalu konfirmasi konsultasi lanjutan.
  videoSelesaiAt DateTime? @map("video_selesai_at")
  // Diisi saat peserta mengirim konfirmasi konsultasi lanjutan (bukan lagi oleh pembayaran).
  konsultasiAt   DateTime? @map("konsultasi_at")
  // Posisi peserta: A | B | C | D (lihat redaksi di modal konsultasi lanjutan).
  posisiKonsultasi String?  @map("posisi_konsultasi") @db.VarChar(10)
  posisiDijawabAt  DateTime? @map("posisi_dijawab_at")
  // Opsi D hanya boleh dipilih jika peserta memiliki ijazah S1.
  ijazahS1        Boolean   @default(false) @map("ijazah_s1")
  jadwal      JadwalSesi[]
  waitinglist Waitinglist?
  pembayaran  PembayaranKonsultasi[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("pendaftaran")
}

// Pengaturan umum situs berbentuk key-value, diubah lewat halaman admin.
// Dipakai antara lain untuk link grup WhatsApp per wilayah.
model Pengaturan {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pengaturan")
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

// Slot jadwal konsultasi lanjutan yang ditetapkan admin (fix).
// Satu slot bisa diisi sampai `kuota` peserta (default 5).
model JadwalSlot {
  id        Int      @id @default(autoincrement())
  tanggal   String   @db.VarChar(10)
  jam       String   @db.VarChar(5)
  kuota     Int      @default(5)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tanggal, jam])
  @@map("jadwal_slot")
}

// Antrean peserta saat semua slot jadwal sudah penuh.
model Waitinglist {
  id            Int      @id @default(autoincrement())
  pendaftaranId Int      @unique @map("pendaftaran_id")
  posisi        String?  @db.VarChar(10)
  catatan       String?  @db.VarChar(500)
  // menunggu | diproses | ditambahkan | batal
  status        String   @default("menunggu") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  pendaftaran   Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("waitinglist")
}

// Jadwal sesi konsultasi lanjutan yang dipilih peserta.
// tanggal "YYYY-MM-DD" & jam "HH:mm" dalam WIB.
// slotKey = "tanggal_jam_kursi" (kursi 1..kuota) selama jadwal aktif,
// NULL jika batal/ditolak. Unique mencegah satu kursi diambil dua peserta.
model JadwalSesi {
  id            Int         @id @default(autoincrement())
  pendaftaranId Int         @map("pendaftaran_id")
  tanggal       String      @db.VarChar(10)
  jam           String      @db.VarChar(5)
  catatan       String?     @db.VarChar(500)
  // menunggu | dikonfirmasi | selesai | batal | ditolak
  status        String      @default("menunggu") @db.VarChar(20)
  slotKey       String?     @unique @map("slot_key") @db.VarChar(20)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  pendaftaran   Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)

  @@index([pendaftaranId])
  @@index([tanggal])
  @@map("jadwal_sesi")
}

// Pembayaran aktivasi akun (Rp49.000) — satu-satunya pembayaran, dilakukan sebelum
// peserta bisa masuk member area. Layer checkout konsultasi lanjutan sudah dihapus.
model PembayaranKonsultasi {
  id            Int         @id @default(autoincrement())
  pendaftaranId Int         @map("pendaftaran_id")
  // Snapshot data diri peserta saat checkout.
  nama          String      @db.VarChar(255)
  whatsapp      String      @db.VarChar(30)
  email         String      @db.VarChar(255)
  // bank | ewallet
  metode        String      @db.VarChar(20)
  // Nama bank / e-wallet yang dipilih (mis. BCA, DANA).
  namaChannel   String      @map("nama_channel") @db.VarChar(100)
  namaPengirim  String      @map("nama_pengirim") @db.VarChar(255)
  buktiBayar    String      @map("bukti_bayar") @db.VarChar(500)
  jumlah        Int         @default(49000)
  // menunggu | dikonfirmasi | ditolak
  status        String      @default("menunggu") @db.VarChar(20)
  catatanAdmin  String?     @map("catatan_admin") @db.Text
  verifiedAt    DateTime?   @map("verified_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  pendaftaran   Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)

  @@index([pendaftaranId])
  @@index([status])
  @@map("pembayaran_konsultasi")
}
